<%- include('../partials/header') %>
<div class="container py-5">
  <h1 class="fw-bold mb-4">Healthcare Products</h1>

  <form method="GET" action="/products" class="row g-2 mb-4">
    <div class="col-sm-5">
      <input type="text" name="search" class="form-control" placeholder="Search products" value="<%= filters.search %>">
    </div>
    <div class="col-sm-3">
      <select name="category" class="form-select">
        <option value="">All Categories</option>
        <% categories.forEach(function(cat) { %>
          <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
        <% }); %>
      </select>
    </div>
    <div class="col-sm-2">
      <select name="sort" class="form-select">
        <option value="">Sort</option>
        <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
      </select>
    </div>
    <div class="col-sm-2">
      <button type="submit" class="btn btn-primary w-100">Apply</button>
    </div>
  </form>

  <div class="row g-4">
    <% products.forEach(function(p) { %>
      <div class="col-6 col-md-4 col-lg-3">
        <div class="card h-100">
          <img src="/images/<%= p.image %>" onerror="this.onerror=null;this.src='/images/placeholder.svg'" class="card-img-top product-thumb" alt="<%= p.name %>">
          <div class="card-body">
            <p class="small text-muted mb-1"><%= p.category %></p>
            <h6 class="card-title"><%= p.name %></h6>
            <p class="fw-bold text-primary mb-2"><%= formatCurrency(p.price) %></p>
            <a href="/products/<%= p.id %>" class="btn btn-sm btn-outline-primary w-100">View</a>
          </div>
        </div>
      </div>
    <% }); %>
    <% if (!products.length) { %><p class="text-muted">No products matched your search.</p><% } %>
  </div>
</div>
<%- include('../partials/footer') %>
