<%- include('../partials/header') %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card p-4">
        <div class="text-center mb-3">
          <i class="bi bi-calendar-check-fill text-primary display-4"></i>
          <h1 class="fw-bold mt-2">Appointment #<%= appointment.id %></h1>
          <span class="badge badge-status-<%= appointment.status %> fs-6"><%= appointment.status %></span>
        </div>
        <hr>
        <p><span class="text-muted">Doctor:</span> <%= appointment.doctor_name %> (<%= appointment.specialization %>)</p>
        <p><span class="text-muted">Department:</span> <%= appointment.department_name %></p>
        <p><span class="text-muted">Date:</span> <%= formatDate(appointment.appointment_date) %></p>
        <p><span class="text-muted">Time:</span> <%= formatTime(appointment.appointment_time) %></p>
        <p><span class="text-muted">Consultation Fee:</span> <%= formatCurrency(appointment.consultation_fee) %></p>
        <% if (appointment.reason) { %>
          <p><span class="text-muted">Reason:</span> <%= appointment.reason %></p>
        <% } %>
        <p><span class="text-muted">Booked on:</span> <%= formatDate(appointment.created_at) %></p>

        <div class="d-flex gap-2 mt-3">
          <a href="/appointments" class="btn btn-outline-primary">Back to My Appointments</a>
          <% if (appointment.status === 'pending' || appointment.status === 'confirmed') { %>
            <form method="POST" action="/appointments/<%= appointment.id %>/cancel" onsubmit="return confirm('Cancel this appointment?');">
              <button type="submit" class="btn btn-outline-danger">Cancel Appointment</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
