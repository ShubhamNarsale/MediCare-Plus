<%- include('../partials/header') %>
<div class="container py-5">
  <h1 class="fw-bold mb-4">Order History</h1>

  <% if (!orders.length) { %>
    <div class="text-center py-5">
      <i class="bi bi-bag-x display-1 text-muted"></i>
      <p class="lead text-muted mt-3">You haven't placed any orders yet.</p>
      <a href="/products" class="btn btn-primary">Browse Products</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr><th>Order #</th><th>Date</th><th>Total</th><th>Payment</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% orders.forEach(function(o) { %>
            <tr>
              <td>#<%= o.id %></td>
              <td><%= formatDate(o.created_at) %></td>
              <td><%= formatCurrency(o.total_amount) %></td>
              <td><%= o.payment_method %> <span class="small text-muted">(<%= o.payment_status %>)</span></td>
              <td><span class="badge badge-status-<%= o.order_status %>"><%= o.order_status %></span></td>
              <td><a href="/patient/orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
