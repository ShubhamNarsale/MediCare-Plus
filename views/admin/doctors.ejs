<%- include('../partials/header') %>
<%- include('_nav') %>
<div class="container pb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">Manage Doctors</h1>
    <a href="/admin/doctors/add" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Doctor</a>
  </div>

  <% if (!doctors.length) { %>
    <p class="text-muted">No doctors added yet.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr><th>Name</th><th>Specialization</th><th>Department</th><th>Fee</th><th>Experience</th><th></th></tr>
        </thead>
        <tbody>
          <% doctors.forEach(function(d) { %>
            <tr>
              <td><%= d.name %></td>
              <td><%= d.specialization %></td>
              <td><%= d.department_name %></td>
              <td><%= formatCurrency(d.consultation_fee) %></td>
              <td><%= d.experience %> yrs</td>
              <td class="d-flex gap-1">
                <a href="/admin/doctors/<%= d.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
                <form method="POST" action="/admin/doctors/<%= d.id %>/delete" onsubmit="return confirm('Delete this doctor?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
