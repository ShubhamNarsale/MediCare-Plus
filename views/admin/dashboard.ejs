<%- include('../partials/header') %>
<%- include('_nav') %>
<div class="container pb-5">
  <h1 class="fw-bold mb-4">Admin Dashboard</h1>
  <div class="row g-3">
    <div class="col-sm-6 col-lg-4">
      <div class="card stat-card p-3">
        <p class="text-muted small mb-1"><i class="bi bi-people-fill"></i> Total Patients</p>
        <p class="fs-3 fw-bold mb-0"><%= stats.totalPatients %></p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-4">
      <div class="card stat-card p-3">
        <p class="text-muted small mb-1"><i class="bi bi-person-badge-fill"></i> Total Doctors</p>
        <p class="fs-3 fw-bold mb-0"><%= stats.totalDoctors %></p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-4">
      <div class="card stat-card p-3">
        <p class="text-muted small mb-1"><i class="bi bi-calendar-check-fill"></i> Total Appointments</p>
        <p class="fs-3 fw-bold mb-0"><%= stats.totalAppointments %></p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-4">
      <div class="card stat-card p-3">
        <p class="text-muted small mb-1"><i class="bi bi-box-seam-fill"></i> Total Products</p>
        <p class="fs-3 fw-bold mb-0"><%= stats.totalProducts %></p>
      </div>
    </div>
    <div class="col-sm-6 col-lg-4">
      <div class="card stat-card p-3">
        <p class="text-muted small mb-1"><i class="bi bi-bag-check-fill"></i> Total Orders</p>
        <p class="fs-3 fw-bold mb-0"><%= stats.totalOrders %></p>
      </div>
    </div>
  </div>

  <div class="row g-3 mt-4">
    <div class="col-sm-6 col-lg-3"><a href="/admin/doctors/add" class="btn btn-primary w-100">+ Add Doctor</a></div>
    <div class="col-sm-6 col-lg-3"><a href="/admin/products/add" class="btn btn-primary w-100">+ Add Product</a></div>
    <div class="col-sm-6 col-lg-3"><a href="/admin/appointments" class="btn btn-outline-primary w-100">Manage Appointments</a></div>
    <div class="col-sm-6 col-lg-3"><a href="/admin/orders" class="btn btn-outline-primary w-100">Manage Orders</a></div>
  </div>
</div>
<%- include('../partials/footer') %>
