<%- include('../partials/header') %>
<div class="container py-5">
  <h1 class="fw-bold mb-4">Facilities at <%= hospital ? hospital.name : 'MediCare+' %></h1>
  <div class="row g-3">
    <% facilities.forEach(function(item) { %>
      <div class="col-sm-6 col-lg-4">
        <div class="card p-3 h-100 d-flex flex-row align-items-center gap-2">
          <i class="bi bi-check-circle-fill text-primary fs-4"></i>
          <span><%= item %></span>
        </div>
      </div>
    <% }); %>
    <% if (!facilities.length) { %><p class="text-muted">No facilities listed yet.</p><% } %>
  </div>
</div>
<%- include('../partials/footer') %>
