<%- include('../partials/header') %>
<div class="container py-5">
  <h1 class="fw-bold mb-4">About <%= hospital ? hospital.name : 'MediCare+' %></h1>
  <% if (hospital) { %>
    <p class="lead"><%= hospital.description %></p>
    <p><%= hospital.about %></p>
    <div class="row g-3 mt-3">
      <div class="col-md-4">
        <div class="card p-3"><i class="bi bi-geo-alt-fill text-primary"></i> <%= hospital.address %></div>
      </div>
      <div class="col-md-4">
        <div class="card p-3"><i class="bi bi-telephone-fill text-primary"></i> <%= hospital.phone %></div>
      </div>
      <div class="col-md-4">
        <div class="card p-3"><i class="bi bi-envelope-fill text-primary"></i> <%= hospital.email %></div>
      </div>
    </div>
  <% } else { %>
    <p class="text-muted">Hospital information is not available yet.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
