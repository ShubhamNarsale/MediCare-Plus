<%- include('../partials/header') %>
<div class="container py-5">
  <div class="text-center mb-4">
    <i class="bi bi-check-circle-fill text-success display-3"></i>
    <h1 class="fw-bold mt-2">Order #<%= order.id %></h1>
    <p class="text-muted">Placed on <%= formatDate(order.created_at) %></p>
  </div>

  <div class="row g-4">
    <div class="col-md-7">
      <div class="card p-3">
        <h5 class="fw-semibold mb-3">Items</h5>
        <table class="table align-middle mb-0">
          <tbody>
            <% items.forEach(function(item) { %>
              <tr>
                <td class="d-flex align-items-center gap-2">
                  <img src="/images/<%= item.image %>" onerror="this.onerror=null;this.src='/images/placeholder.svg'" style="width:48px;height:48px;object-fit:cover;border-radius:.5rem;" alt="<%= item.name %>">
                  <span><%= item.name %></span>
                </td>
                <td><%= item.quantity %> &times; <%= formatCurrency(item.price) %></td>
                <td class="text-end"><%= formatCurrency(item.subtotal) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="col-md-5">
      <div class="card p-3">
        <h5 class="fw-semibold mb-3">Order Details</h5>
        <p><span class="text-muted">Status:</span>
          <span class="badge badge-status-<%= order.order_status %>"><%= order.order_status %></span>
        </p>
        <p><span class="text-muted">Payment:</span> <%= order.payment_method %> (<%= order.payment_status %>)</p>
        <p><span class="text-muted">Shipping to:</span><br><%= order.shipping_address %></p>
        <hr>
        <div class="d-flex justify-content-between fw-bold fs-5"><span>Total</span><span><%= formatCurrency(order.total_amount) %></span></div>
      </div>
      <a href="/patient/orders" class="btn btn-outline-primary w-100 mt-3">Back to Order History</a>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
