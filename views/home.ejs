<%- include('partials/header') %>

<div class="hero-section text-center">
  <div class="container">
    <h1 class="display-5 fw-bold"><%= hospital ? hospital.name : 'MediCare+' %></h1>
    <p class="lead mb-4"><%= hospital ? hospital.description : 'Your Health, Our Priority' %></p>
    <a href="/doctors" class="btn btn-light btn-lg me-2">Find a Doctor</a>
    <a href="/hospital/emergency" class="btn btn-outline-light btn-lg">Emergency Info</a>
  </div>
</div>

<div class="container py-5">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Our Departments</h2>
    <a href="/hospital/departments" class="small">View all &rarr;</a>
  </div>
  <div class="row g-4 mb-5">
    <% departments.forEach(function(dept) { %>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/hospital/departments" class="text-decoration-none text-dark">
          <div class="card h-100 text-center p-3">
            <img src="/images/<%= dept.image %>" onerror="this.onerror=null;this.src='/images/placeholder.svg'" class="mx-auto mb-2" style="width:56px;height:56px;object-fit:cover;border-radius:50%;" alt="<%= dept.name %>">
            <div class="fw-semibold small"><%= dept.name %></div>
          </div>
        </a>
      </div>
    <% }); %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Featured Doctors</h2>
    <a href="/doctors" class="small">View all &rarr;</a>
  </div>
  <div class="row g-4 mb-5">
    <% doctors.forEach(function(doc) { %>
      <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
          <img src="/images/<%= doc.image %>" onerror="this.onerror=null;this.src='/images/placeholder.svg'" class="card-img-top doctor-avatar" alt="<%= doc.name %>">
          <div class="card-body">
            <h5 class="card-title mb-1"><%= doc.name %></h5>
            <p class="text-primary small mb-1"><%= doc.specialization %></p>
            <p class="small text-muted mb-3"><%= doc.department_name %> &middot; <%= doc.experience %> yrs experience</p>
            <a href="/doctors/<%= doc.id %>" class="btn btn-sm btn-primary">View Profile</a>
          </div>
        </div>
      </div>
    <% }); %>
    <% if (!doctors.length) { %><p class="text-muted">No doctors available yet.</p><% } %>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 fw-bold mb-0">Healthcare Products</h2>
    <a href="/products" class="small">View all &rarr;</a>
  </div>
  <div class="row g-4">
    <% products.forEach(function(p) { %>
      <div class="col-6 col-md-4 col-lg-2">
        <div class="card h-100">
          <img src="/images/<%= p.image %>" onerror="this.onerror=null;this.src='/images/placeholder.svg'" class="card-img-top product-thumb" alt="<%= p.name %>">
          <div class="card-body p-2">
            <p class="small fw-semibold mb-1"><%= p.name %></p>
            <p class="small text-primary fw-bold mb-2"><%= formatCurrency(p.price) %></p>
            <a href="/products/<%= p.id %>" class="btn btn-sm btn-outline-primary w-100">View</a>
          </div>
        </div>
      </div>
    <% }); %>
    <% if (!products.length) { %><p class="text-muted">No products available yet.</p><% } %>
  </div>

</div>

<%- include('partials/footer') %>
